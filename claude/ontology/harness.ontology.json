{
  "$comment": "Line Harness ontology: the single source for routing, quota, review and permission rules. Consumers: Line Hub (routeAdvice, alert RULES), CLAUDE.md generated blocks, ontology-check sensor. Edit here, then run ontology-check --write. Owner: Line. Values copied from the live system on 2026-11-15.",
  "version": "1.0.0",
  "updated": "2026-11-15",
  "objects": {
    "models": [
      {
        "id": "opus",
        "side": "claude",
        "name": "Opus 5.5",
        "slug": "claude-opus-5-5",
        "roles": [
          "supervisor",
          "opus-subagent-worker"
        ]
      },
      {
        "id": "fable51",
        "side": "claude",
        "name": "Fable 5.1",
        "slug": "claude-fable-5-1",
        "roles": [
          "layer3-important",
          "root-cause",
          "architecture"
        ]
      },
      {
        "id": "fable52",
        "side": "claude",
        "name": "Fable 5.2",
        "slug": "claude-fable-5-2",
        "roles": [
          "layer3-critical",
          "fable-subagent"
        ],
        "note": "The Agent tool `fable` alias reported itself as claude-fable-5-2 on 2026-11-14."
      },
      {
        "id": "sol",
        "side": "codex",
        "name": "GPT-6 Sol",
        "slug": "gpt-6-sol",
        "defaultEffort": "high"
      },
      {
        "id": "astra",
        "side": "codex",
        "name": "GPT-6 Astra",
        "slug": "gpt-6-astra",
        "defaultEffort": "high",
        "fallbackEffort": "xhigh"
      },
      {
        "id": "luna",
        "side": "codex",
        "name": "GPT-6 Luna",
        "slug": "gpt-6-luna",
        "defaultEffort": "max"
      },
      {
        "id": "sol61",
        "side": "codex",
        "name": "GPT-6.1 Sol",
        "slug": "gpt-6.1-sol",
        "status": "candidate",
        "note": "Not routed. 5/5 runs had sandbox failures and ~4.6M tokens/run (Hub, 2026-11-14). A/B test before use."
      }
    ],
    "tiers": [
      {
        "id": "Skip",
        "when": "under ~20 lines of config, typo, docs",
        "layers": [
          3
        ]
      },
      {
        "id": "Standard-A",
        "when": "1-2 files, runnable VALIDATE, single-branch logic, worked examples",
        "layers": [
          1,
          3
        ],
        "layer2": "optional over ~150 lines, logged"
      },
      {
        "id": "Standard-B",
        "when": "3+ files, long command chains, repo discovery, vague VALIDATE, prior Sol STOP/FAIL",
        "layers": [
          1,
          3
        ],
        "layer2": "optional over ~150 lines, logged"
      },
      {
        "id": "Important",
        "when": "multi-file, API contract, shared module",
        "layers": [
          1,
          2,
          3
        ],
        "layer2": "gpt-6-astra (mandatory) + a Fable subagent",
        "preRead": "Fable subagent reads the packet before dispatch"
      },
      {
        "id": "Critical",
        "when": "security, payment, auth, migration",
        "layers": [
          1,
          2,
          3
        ],
        "layer2": "gpt-6-astra (mandatory) + a Fable 5.2 subagent",
        "preRead": "Fable 5.2",
        "approval": "Line approves in writing"
      },
      {
        "id": "Exploration",
        "when": "locate, list, count, inventory, synthesis",
        "layers": [
          3
        ]
      }
    ],
    "artifacts": [
      {
        "id": "packet",
        "file": "<repo>/.packets/*.md",
        "producedBy": "supervisor",
        "requires": [
          "GOAL",
          "BUSINESS REASON",
          "SUCCESS CRITERIA",
          "FILES",
          "PATTERNS",
          "CONSTRAINTS",
          "NON-GOALS",
          "DONE WHEN",
          "VALIDATE",
          "STOP RULES",
          "ROLLBACK",
          "DOCS CHECKED",
          "PACKET CHECK"
        ]
      },
      {
        "id": "run",
        "file": "~/.claude/state/runs/<runId>/run.json",
        "producedBy": "codex-do.ps1",
        "links": [
          "packet via specSha256"
        ]
      },
      {
        "id": "review",
        "file": "~/.claude/state/reviews.jsonl",
        "producedBy": "codex-review.ps1",
        "fields": [
          "mode: gates-only|model",
          "verdict",
          "criteria: complete|incomplete|none|n/a"
        ]
      },
      {
        "id": "ledger",
        "file": "~/.claude/state/review-ledger.log",
        "producedBy": "ledger-add.ps1 -SpecFile <packet>",
        "links": [
          "runs via runs="
        ]
      },
      {
        "id": "handoff",
        "file": "~/.handoff/handoff-<date>-<time>.md",
        "producedBy": "supervisor"
      }
    ]
  },
  "quota": {
    "paceDefinition": "pace = used % / % of the window elapsed; ignored in the first 5% of a window",
    "thresholds": {
      "codexPace1": 1,
      "codexPace2": 1.3,
      "codexUsed1": 70,
      "codexUsed2": 85,
      "codexUsed3": 95,
      "claudePace": 1.2,
      "claudeUsed": 70,
      "claude5Used": 80
    },
    "codexLevels": [
      {
        "id": "C0",
        "test": "pace <= codexPace1 and used < codexUsed1",
        "route": "Normal routing table.",
        "label": "Pace <= {codexPace1} and used < {codexUsed1}%"
      },
      {
        "id": "C1",
        "test": "pace > codexPace1 (to codexPace2) or used codexUsed1..codexUsed2-1, or over daily budget",
        "route": "Standard-B with <= 3 files and a runnable VALIDATE goes to `gpt-6-sol` high. No Luna exploration (Claude Explore subagent). Layer 2 = Fable subagent.",
        "label": "Pace > {codexPace1} to {codexPace2}, used {codexUsed1}-{codexUsed2-1}%, or over daily budget"
      },
      {
        "id": "C2",
        "test": "pace > codexPace2 or used codexUsed2..codexUsed3-1",
        "route": "Codex for Important/Critical. Standard work goes to an Opus subagent with the same packet (if Claude is stressed too, see below). No resumes.",
        "label": "Pace > {codexPace2} or used {codexUsed2}-{codexUsed3-1}%"
      },
      {
        "id": "C3",
        "test": "used >= codexUsed3",
        "route": "No Codex. Opus subagent = worker, Fable subagent = layer 2, ledger `worker=opus`.",
        "label": "Used >= {codexUsed3}%"
      }
    ],
    "claudeRules": [
      {
        "id": "K1",
        "test": "Claude 7-day pace > claudePace or used >= claudeUsed",
        "text": "No Opus subagent workers; layer 2 = Astra; Fable only for Critical layer 3; supervisor edits <= 20 lines.",
        "bullet": "Claude 7-day pace > {claudePace} or used >= {claudeUsed}%: no Opus subagent workers; layer 2 = Astra; Fable only for Critical layer 3; supervisor edits <= 20 lines."
      },
      {
        "id": "BOTH",
        "test": "K1 and Codex not C3",
        "text": "Standard-A and Standard-B go to gpt-6-sol high and are never deferred.",
        "source": "Line 2026-11-15",
        "bullet": "Both sides stressed (Claude rule above active and Codex not >= {codexUsed3}%): Standard-A and Standard-B go to `gpt-6-sol` high and are never deferred (Line, 2026-11-15)."
      },
      {
        "id": "STOP",
        "test": "C3 and K1",
        "text": "No new packets; report to Line. This is the only stop rule.",
        "source": "Line 2026-11-15",
        "bullet": "Codex used >= {codexUsed3}% while the Claude rule is active: no new packets; report to Line. This is the only stop rule."
      },
      {
        "id": "K5",
        "test": "Claude 5-hour used >= claude5Used",
        "text": "Finish the current check, update the handoff, pause Claude work until the window resets.",
        "bullet": "Claude 5-hour used >= {claude5Used}%: finish the current check, update the handoff, pause Claude work until the window resets."
      },
      {
        "id": "THREAD",
        "test": "one Codex session over 50M tokens",
        "text": "Stop and report to Line. Codex desktop and CLI sessions count against the budget.",
        "bullet": "Codex desktop and CLI sessions count against the budget. One session over 50M tokens: stop and report to Line."
      }
    ],
    "dailyBudget": {
      "perSidePctOfWeek": 15,
      "overBudgetBurnPct": 20,
      "tracked": false
    },
    "templateRules": "Placeholders {key} take quota.thresholds[key]; {key-1} subtracts 1; keys containing \"Pace\" print with at least one decimal (1 -> 1.0, 1.3 -> 1.3); others print as integers."
  },
  "routing": {
    "workTypes": [
      "Standard-A",
      "Standard-B",
      "Important/Critical worker",
      "Exploration",
      "Layer-2 review",
      "Layer-3 Important",
