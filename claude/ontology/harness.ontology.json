          "astraNr",
          "explore",
          "fable"
        ],
        "C3": [
          "opus",
          "opus",
          "opus",
          "explore",
          "fable"
        ]
      },
      "K1": {
        "C0": [
          "sol",
          "astra",
          "astra",
          "luna",
          "l2astra"
        ],
        "C1": [
          "sol",
          "sbCond",
          "astra",
          "explore",
          "l2astra"
        ],
        "C2": [
          "sol",
          "sol",
          "astraNr",
          "explore",
