    "layer3": {
      "K0": "Fable via /model",
      "K1": "Opus supervisor (Fable only for Critical)",
      "critical": "Fable 5.2 high via /model claude-fable-5-2"
    },
    "stopText": "No new packets; report to Line",
    "fallback": "gpt-6-astra xhigh, one attempt, then replan. Never start at xhigh.",
    "k5Banner": "Claude 5-hour >= {claude5Used}%: finish the current check, update the handoff, pause Claude work until the window resets"
  },
  "alerts": {
    "$comment": "Line Hub rules a-h. Toasts never stop work.",
    "quotaPace": 1.3,
    "quotaUsed": 85,
    "handoffUsed": 80,
    "commitPct": 90,
    "diskFreePct": 10,
    "folderDays": 14,
    "cleanDrop": 15,
    "cleanMinTasks": 3,
    "vhdxGB": 80,
    "staleSecs": 600,
    "threadTokens": 50000000,
    "threadActiveHours": 48
  },
  "actions": [
    {
      "id": "dispatch-worker",
      "permission": "ALLOW",
      "via": "codex-do.ps1 -Dir <repo ROOT> -SpecFile <packet>",
      "source": "AGENTS.md section 15"
    },
    {
      "id": "install-live",
      "permission": "ALLOW",
      "note": "supervisor copies verified repo files into ~/.claude or ~/.codex after layer 3",
      "source": "harness upgrade mandate 2026-10-10"
    },
    {
      "id": "commit",
      "permission": "LINE_ONLY",
      "note": "only when Line orders that exact action in the current conversation",
      "source": "AGENTS.md section 15"
    },
    {
      "id": "push",
      "permission": "LINE_ONLY",
      "enforcedBy": [
        "git-push-guard.ps1"
      ],
      "source": "AGENTS.md section 15"
    },
    {
      "id": "open-pr",
      "permission": "ASK",
      "note": "never pick the target branch; ask Line",
      "source": "AGENTS.md section 13"
    },
    {
      "id": "deploy-release",
      "permission": "LINE_ONLY",
      "source": "AGENTS.md section 7"
    },
    {
      "id": "delete-outside-project",
      "permission": "LINE_ONLY",
      "source": "AGENTS.md section 7"
    },
    {
      "id": "db-write-destructive",
      "permission": "LINE_ONLY",
      "note": "two written confirmations + backup + restore plan",
      "source": "AGENTS.md section 7"
    },
    {
      "id": "read-secrets",
      "permission": "LINE_ONLY",
      "source": "AGENTS.md section 7"
    },
    {
      "id": "openrouter-spend",
      "permission": "LINE_ONLY",
      "note": "only openai/gpt-6-luna runs; exceptions need OPENROUTER_GUARD_OVERRIDE=1 and Line naming model + budget",
      "enforcedBy": [
        "openrouter-model-guard.ps1"
      ]
    },
    {
      "id": "stop-for-low-ram",
      "permission": "NEVER",
      "note": "sessions always run; Windows ends a process if memory truly runs out",
      "source": "Line 2026-11-14"
    },
    {
      "id": "ask-line-to-clear",
      "permission": "NEVER",
      "note": "compaction handles context; at 85%+ update the handoff silently",
      "source": "Line 2026-11-15"
    }
  ],
  "hooks": {
    "claude": [
      {
        "event": "SessionStart",
        "script": "ontology-check.js"
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash|PowerShell",
        "script": "shell-guards.ps1",
        "enforces": [
          "push",
          "openrouter-spend",
          "no-heredoc"
        ]
      },
      {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit",
        "script": "edit-delegation-guard.ps1",
        "enforces": [
          "delegation"
        ]
      },
      {
        "event": "PostToolUse",
        "matcher": "*",
        "script": "inel-event.js"
      },
      {
        "event": "PostToolUse",
        "matcher": "mcp__.*|Skill|Agent",
        "script": "track-tools.js"
      },
      {
        "event": "PostToolUse",
        "matcher": "Edit|Write",
        "script": "quality-typecheck.ps1"
      },
      {
        "event": "PostToolUse",
        "matcher": "Edit|Write",
        "script": "quality-console-warn.ps1"
      },
      {
        "event": "Notification",
        "script": "notify-sound.ps1"
      },
      {
        "event": "Notification",
        "script": "inel-event.js"
      },
      {
        "event": "Stop",
        "script": "notify-sound.ps1"
      },
      {
        "event": "Stop",
        "script": "inel-event.js"
      },
      {
        "event": "Stop",
        "script": "collect.js"
      },
      {
        "event": "UserPromptSubmit",
        "script": "edit-delegation-guard.ps1"
      },
      {
        "event": "UserPromptSubmit",
        "script": "context-guard.ps1",
        "enforces": [
          "ask-line-to-clear"
        ]
      },
      {
        "event": "UserPromptSubmit",
        "script": "inel-event.js"
      },
      {
        "event": "SessionEnd",
        "script": "inel-event.js"
      },
      {
        "event": "PostToolUseFailure",
        "script": "inel-event.js"
      },
      {
        "event": "SessionStart",
        "script": "codex-job-watcher.ps1"
      },
      {
        "event": "SessionStart",
        "script": "edit-delegation-guard.ps1"
      },
      {
        "event": "SessionStart",
        "script": "collect.js"
      }
    ],
    "codex": [
      "codex-delegation-reminder.ps1",
      "codex-job-watcher.ps1",
      "git-push-guard.ps1",
      "notify-sound.ps1",
      "quality-console-warn.ps1",
      "quality-typecheck.ps1",
      "track-tools.js"
    ],
    "retired": [
      {
        "script": "packet-docs-guard.ps1",
        "date": "2026-11-15",
        "why": "replaced by codex-do packet lint (exit 74)"
      },
      {
        "script": "codegraph-init-check.ps1",
        "date": "2026-11-15",
        "why": "codegraph MCP removed (4 calls in 30 days)"
      }
    ]
  },
  "rules": [
    {
      "id": "repo-root-dir",
      "text": "Always pass the repo ROOT as -Dir; one worker per repo at a time.",
      "date": "2026-11-15",
      "enforcement": "PROSE",
      "note": "codex-do Dir lock only blocks two workers in one Dir; nothing forces the repo root yet"
    },
    {
      "id": "ledger-specfile",
      "text": "Write every ledger line with ledger-add.ps1 -SpecFile <packet>.",
      "date": "2026-11-14",
      "enforcement": "PROSE"
    },
    {
      "id": "fail-limit",
      "text": "After 2 FAILs at Important/Critical (3 at Standard) stop, report to Line, redesign.",
      "values": {
        "important": 2,
        "standard": 3
      },
      "enforcement": "PROSE"
    },
    {
      "id": "ram-never-blocks",
      "text": "The RAM check reports commit headroom only; it never blocks, waits or stops.",
      "date": "2026-11-14",
      "enforcement": "SENSOR",
      "enforcedBy": [
        "ram-preflight.ps1 always returns true",
        "claude/tests/ram-preflight.test.ps1"
      ]
    },
    {
      "id": "context-silent",
      "text": "Silent below 85% context; at 85%+ update the handoff and keep working.",
      "values": {
        "silentBelowPct": 85
      },
      "date": "2026-11-15",
      "enforcement": "HOOK",
      "enforcedBy": [
        "context-guard.ps1"
      ]
    },
    {
      "id": "critical-fable52",
      "text": "Every Fable step at Critical uses Fable 5.2.",
      "date": "2026-11-14",
      "enforcement": "PROSE"
    },
    {
      "id": "review-evidence",
      "text": "Layer 2 counts only from explicit evidence: ledger field 3 'yes', or a stated L2 result; GATES-PASS is not a model review.",
      "date": "2026-11-15",
      "enforcement": "SENSOR",
      "enforcedBy": [
        "hub/collector/ledger.js",
        "hub/tests/v10.test.js"
      ]
    },
    {
      "id": "no-codegraph",
      "text": "codegraph is removed; use Grep and line-range Read for code.",
      "date": "2026-11-15",
      "enforcement": "PROSE"
    }
  ],
  "staleValues": [
    {
      "pattern": "60/70/80",
      "why": "context nags were removed 2026-11-15 (context-silent)"
    },
    {
      "pattern": "Fable 5\\.1[^\\n]{0,40}Critical|Critical[^\\n]{0,40}Fable 5\\.1",
      "why": "Critical uses Fable 5.2 (critical-fable52)"
    },
    {
      "pattern": "codegraph_explore|codegraph init",
      "why": "codegraph removed (no-codegraph)"
    },
    {
      "pattern": "exit 75|not enough free RAM",
      "why": "RAM never blocks (ram-never-blocks)"
    },
    {
      "pattern": "Both sides used > ?85",
      "why": "only stop rule is C3+K1 (STOP)"
    }
  ],
  "reviewTable": [
    [
      "Skip (under ~20 lines of config, typo, docs)",
      "3"
    ],
    [
      "Standard-A / Standard-B",
      "1 + 3 (`codex-review.ps1 -SkipModel`); layer 2 optional over ~150 lines, logged"
    ],
    [
      "Important (multi-file, API contract, shared module)",
      "1 + 2 (`gpt-6-astra`, mandatory) + a Fable 5.1 subagent + 3"
    ],
    [
      "Critical (security, payment, auth, migration)",
      "Important + Line approves in writing"
    ]
  ]
}
