+# Intent: remind the supervisor to delegate only when an inline edit is large (2026-11-12, Line).
+#   -Mode check   PreToolUse Edit|Write|MultiEdit: non-blocking additionalContext when one edit adds
+#                 more than 50 non-blank lines, or when this is the 3rd+ distinct file edited since the last prompt.
+#   -Mode reset   UserPromptSubmit: clears distinct files, keeps the session line budget. Silent.
+#   -Mode session SessionStart: prints one delegation line and prunes state files older than 24 h.
+# Exempt: ~/.claude/projects/*/memory, any .handoff or .packets folder, Claude scratchpads, subagents (agent_id).
+# State: ~/.claude/state/edit-delegation/<session_id>.json = {files: [...], addedLines: N}.
+# Legacy path arrays migrate on the next call. Prompt resets and edits use the same exclusive lock.
+# Intent: warn above 150 session lines; mark OVER BUDGET above 300. Never deny.
+# Status: fixture-covered. Next: supervisor installs. Blockers: none. Confidence: high.
+# Speed: .NET only, no nested functions; cmdlet JSON and path cmdlets add ~110 ms of module load.
+# Fails open: any error = exit 0, no output. Never denies. Confidence: high.
+param([string]$Mode = 'check')
+
+$stateDir = [IO.Path]::Combine($env:USERPROFILE, '.claude', 'state', 'edit-delegation')
+
+if ($Mode -eq 'session') {
+    [Console]::Out.WriteLine('[DELEGATION] Multi-file or >50-line coding goes to the worker (codex-do.ps1, or an Opus subagent when Codex is off); inline Edit/Write is for small fixes. A PreToolUse hook warns on large inline edits.')
+    try {
+        if ([IO.Directory]::Exists($stateDir)) {
+            $cut = [DateTime]::UtcNow.AddHours(-24)
+            foreach ($f in [IO.Directory]::GetFiles($stateDir, '*.json')) {
+                if ([IO.File]::GetLastWriteTimeUtc($f) -lt $cut) { [IO.File]::Delete($f) }
+            }
+        }
+    }
+    catch {}
+    exit 0
+}
+
+try {
+    $raw = [Console]::In.ReadToEnd()
+
+    [void][Reflection.Assembly]::LoadWithPartialName('System.Web.Extensions')
+    $json = [System.Web.Script.Serialization.JavaScriptSerializer]::new()
+    $json.MaxJsonLength = 67108864
+    $request = $json.DeserializeObject($raw)
+    $sid = [string]$request['session_id']
+    if (-not $sid) { exit 0 }
+    # Subagents are the worker when Codex is off; the reminder targets the main (supervisor) thread only.
+    if ($request.ContainsKey('agent_id') -and $request['agent_id']) { exit 0 }
+
+    $added = 0
+    $full = ''
+    if ($Mode -ne 'reset') {
+        $tool = [string]$request['tool_name']
+        if ($tool -ne 'Edit' -and $tool -ne 'Write' -and $tool -ne 'MultiEdit') { exit 0 }
+        $ti = $request['tool_input']
+        $path = [string]$ti['file_path']
+        if (-not $path) { exit 0 }
+        $full = [IO.Path]::GetFullPath($path)
+        if ($full -match '(?i)\\\.claude\\projects\\[^\\]+\\memory(\\|$)' -or
+            $full -match '(?i)\\\.handoff(\\|$)' -or
+            $full -match '(?i)\\\.packets(\\|$)' -or
+            $full -match '(?i)\\Temp\\claude\\.*\\scratchpad(\\|$)') { exit 0 }
+
+        # Added lines = non-blank lines in the new text that are not in the old text.
+        $pairs = [System.Collections.Generic.List[object]]::new()
+        if ($tool -eq 'Write') {
+            $old = ''
+            if ([IO.File]::Exists($full)) { $old = [IO.File]::ReadAllText($full) }
+            $pairs.Add(@($old, [string]$ti['content']))
+        }
+        elseif ($tool -eq 'Edit') { $pairs.Add(@([string]$ti['old_string'], [string]$ti['new_string'])) }
+        else { foreach ($e in @($ti['edits'])) { $pairs.Add(@([string]$e['old_string'], [string]$e['new_string'])) } }
+        $added = 0
+        foreach ($pair in $pairs) {
+            if (-not $pair[1]) { continue }
+            $oldSet = [System.Collections.Generic.HashSet[string]]::new()
+            if ($pair[0]) { foreach ($l in ($pair[0] -split "`r?`n")) { [void]$oldSet.Add($l.Trim()) } }
+            foreach ($l in ($pair[1] -split "`r?`n")) {
+                $t = $l.Trim()
+                if ($t.Length -gt 0 -and -not $oldSet.Contains($t)) { $added++ }
+            }
+        }
+    }
+
+    # Per-session state, read-modify-write under an exclusive lock (FileShare.None) so parallel tool
+    # calls of one session do not lose each other's files. Up to 5 tries x 10 ms; then fail open:
+    # the file list counts as empty and nothing is written. Malformed content counts as empty.
+    $stateFile = [IO.Path]::Combine($stateDir, ([regex]::Replace($sid, '[^A-Za-z0-9_.-]', '_') + '.json'))
+    $files = [System.Collections.Generic.List[string]]::new()
+    $key = $full.ToLowerInvariant()
+    $isNew = $true
+    $total = [long]0
+    $fs = $null
+    try {
+        if (-not [IO.Directory]::Exists($stateDir)) { [void][IO.Directory]::CreateDirectory($stateDir) }
+        for ($try = 0; $try -lt 5 -and -not $fs; $try++) {
+            try { $fs = [IO.File]::Open($stateFile, [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None) }
+            catch { [Threading.Thread]::Sleep(10) }
+        }
+        if ($fs) {
+            $buf = [byte[]]::new([int]$fs.Length)
+            $read = 0
+            while ($read -lt $buf.Length) { $r = $fs.Read($buf, $read, $buf.Length - $read); if ($r -le 0) { break }; $read += $r }
+            $text = [Text.Encoding]::UTF8.GetString($buf, 0, $read)
+            if ($text.Trim()) {
+                try {
+                    $saved = $json.DeserializeObject($text)
+                    $arr = $saved
+                    if ($saved -is [System.Collections.IDictionary]) {
+                        $arr = $saved['files']
+                        $total = [Math]::Max(0, [long]$saved['addedLines'])
+                    }
+                    if ($arr -is [object[]]) { foreach ($f in $arr) { if ($f -is [string]) { $files.Add($f) } } }
+                }
+                catch { $files.Clear(); $total = 0 }
+            }
+            $isNew = -not $files.Contains($key)
+            if ($Mode -eq 'reset') { $files.Clear() }
+            else {
+                if ($isNew) { $files.Add($key) }
+                $total += $added
+            }
+            $bytes = [Text.Encoding]::UTF8.GetBytes($json.Serialize(@{ files = $files.ToArray(); addedLines = $total }))
+            $fs.SetLength(0); $fs.Write($bytes, 0, $bytes.Length)
+        }
+        else { $files.Add($key) }
+    }
+    catch { $files.Clear(); $files.Add($key) }
+    finally { if ($fs) { $fs.Dispose() } }
+    if ($Mode -eq 'reset') { exit 0 }
+
+    $why = $null
+    if ($added -gt 50) { $why = "this edit adds about $added lines" }
+    elseif ($isNew -and $files.Count -ge 3) { $why = "this is distinct file $($files.Count) edited inline since Line's last prompt" }
+    $msg = ''
+    if ($why) {
+        $msg = "[DELEGATION WARNING] Large inline edit: $why. Work over ~50 lines or 3+ files goes to the worker: codex-do.ps1 with a task packet, or an Opus subagent when Codex is off. Continue inline only for touch-ups to a worker diff or mechanical edits (AGENTS.md section 15)."
+    }
+    if ($total -gt 150) {
+        $over = if ($total -gt 300) { 'OVER BUDGET - ' } else { '' }
+        if ($msg) { $msg += ' ' }
+        $msg += "[EDIT BUDGET] $total lines inline this session - ${over}delegate the rest"
+    }
+    if (-not $msg) { exit 0 }
+    [Console]::Out.WriteLine('{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"' + $msg.Replace('\', '\\').Replace('"', '\"') + '"}}')
+}
+catch {}
+exit 0
diff --git a/claude/hooks/shell-guards.ps1 b/claude/hooks/shell-guards.ps1
new file mode 100644
index 0000000..94a0e15
--- /dev/null
+++ b/claude/hooks/shell-guards.ps1
@@ -0,0 +1,36 @@
+# Intent: run the existing shell guards in order without three PowerShell startups.
+# Status: equivalence-tested. Next: supervisor installs. Blockers: none. Confidence: high.
+# The guard scripts remain the source of truth, including fail-closed push approval.
+try {
+    $raw = [Console]::In.ReadToEnd()
+    # Include the judge tools, which do not need an OpenRouter mention. JSON Unicode
+    # escapes must take the slow path: e.g. p\u0075sh or \u003c\u003cEOF.
+    # PowerShell also accepts backticks inside command tokens (p`u`sh).
+    if ($raw -notmatch '(?i)push|openrouter|label-judges|run-panel|<<|\\u[0-9a-f]{4}|`') { exit 0 }
+
+    $stdin = [Console]::In
+    $stdout = [Console]::Out
+    foreach ($guard in @('git-push-guard.ps1', 'openrouter-model-guard.ps1', 'bash-heredoc-guard.ps1')) {
+        $reader = [IO.StringReader]::new($raw)
+        $writer = [IO.StringWriter]::new()
+        try {
+            [Console]::SetIn($reader)
+            [Console]::SetOut($writer)
+            # Call in a child script scope: its exit returns here, not out of this host.
+            # Each script retains its own tool-name checks (heredocs are Bash only).
+            & (Join-Path $PSScriptRoot $guard)
+        }
+        finally {
+            [Console]::SetIn($stdin)
+            [Console]::SetOut($stdout)
+            $output = $writer.ToString()
+            $reader.Dispose()
+            $writer.Dispose()
+        }
+        if ($output.Trim()) {
+            [Console]::Out.Write($output)
+            exit 0
+        }
+    }
+} catch {}
+exit 0
diff --git a/claude/tests/hook-test-lib.ps1 b/claude/tests/hook-test-lib.ps1
new file mode 100644
index 0000000..e4901be
--- /dev/null
+++ b/claude/tests/hook-test-lib.ps1
@@ -0,0 +1,45 @@
+. (Join-Path $PSScriptRoot 'test-lib.ps1')
+
+# Run real hook entry points with isolated homes; commands in the payload are never executed.
+function Invoke-TestHook {
+    param([string]$Hook, [string]$Payload, [string]$Profile, [string]$Arguments = '')
+    $info = New-Object Diagnostics.ProcessStartInfo
+    $info.FileName = 'powershell.exe'
+    $info.Arguments = '-NoProfile -ExecutionPolicy Bypass -File "' + $Hook + '" ' + $Arguments
+    $info.UseShellExecute = $false
+    $info.CreateNoWindow = $true
+    $info.RedirectStandardInput = $true
+    $info.RedirectStandardOutput = $true
+    $info.RedirectStandardError = $true
+    $info.EnvironmentVariables['USERPROFILE'] = $Profile
+    $info.EnvironmentVariables.Remove('OPENROUTER_GUARD_OVERRIDE')
+    $process = New-Object Diagnostics.Process
+    $process.StartInfo = $info
+    $watch = [Diagnostics.Stopwatch]::StartNew()
+    try {
+        [void]$process.Start()
+        $stdout = $process.StandardOutput.ReadToEndAsync()
+        $stderr = $process.StandardError.ReadToEndAsync()
+        $process.StandardInput.Write($Payload)
+        $process.StandardInput.Close()
+        $process.WaitForExit()
+        $watch.Stop()
+        return [pscustomobject]@{
+            ExitCode = $process.ExitCode
+            Output = $stdout.Result.Trim()
+            Error = $stderr.Result.Trim()
+            Milliseconds = $watch.Elapsed.TotalMilliseconds
+        }
+    }
+    finally { $process.Dispose() }
+}
+
+function New-ShellPayload([string]$Command, [string]$Tool = 'PowerShell') {
+    return @{ tool_name = $Tool; tool_input = @{ command = $Command } } | ConvertTo-Json -Compress -Depth 5
+}
+
+function Get-HookDecision($Result) {
+    if (-not $Result.Output) { return 'allow|' }
+    $output = ($Result.Output | ConvertFrom-Json).hookSpecificOutput
+    return $output.permissionDecision + '|' + $output.permissionDecisionReason
+}
diff --git a/claude/tests/shell-guards.test.ps1 b/claude/tests/shell-guards.test.ps1
new file mode 100644
index 0000000..cf67600
--- /dev/null
+++ b/claude/tests/shell-guards.test.ps1
@@ -0,0 +1,92 @@
+. (Join-Path $PSScriptRoot 'hook-test-lib.ps1')
+$hooks = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\hooks'))
+$combined = Join-Path $hooks 'shell-guards.ps1'
+if (-not (Test-Path -LiteralPath $combined)) { throw 'shell-guards.ps1 is missing' }
+$temp = New-TestFolder
+$cases = @(
+    @{ Name = 'plain PowerShell'; Command = 'Write-Host hello' },
+    @{ Name = 'plain Windows payload'; Raw = '{"tool_name":"PowerShell","cwd":"D:\\repo","tool_input":{"command":"Write-Host hello"}}' },
+    @{ Name = 'plain Bash'; Command = 'ls -la'; Tool = 'Bash' },
+    @{ Name = 'push denied'; Command = 'git push origin main'; Deny = $true },
+    @{ Name = 'push approved'; Command = 'git push origin main'; Flag = $true },
+    @{ Name = 'Bash push denied'; Command = 'git push origin main'; Tool = 'Bash'; Deny = $true },
+    @{ Name = 'Bash push approved'; Command = 'git push origin main'; Tool = 'Bash'; Flag = $true },
+    @{ Name = 'git options'; Command = 'git -C repo --no-pager push origin main'; Deny = $true },
+    @{ Name = 'Bash chain'; Command = 'echo ok && git -C repo push'; Tool = 'Bash'; Deny = $true },
+    @{ Name = 'PowerShell quoted push'; Command = '& git "push"'; Deny = $true },
+    @{ Name = 'PowerShell escaped push'; Command = 'git p`u`sh'; Deny = $true },
+    @{ Name = 'push text'; Command = 'Write-Host "git push origin main"' },
+    @{ Name = 'Bash quoted push text'; Command = 'echo "git push origin main"'; Tool = 'Bash' },
+    @{ Name = 'Bash push comment'; Command = '# git push origin main'; Tool = 'Bash' },
+    @{ Name = 'openrouter denied'; Command = 'curl https://openrouter.ai -d openai/gpt-6-astra'; Deny = $true },
+    @{ Name = 'openrouter override'; Command = 'OPENROUTER_GUARD_OVERRIDE=1 curl https://openrouter.ai -d openai/gpt-6-astra' },
+    @{ Name = 'openrouter allowed model'; Command = 'curl https://openrouter.ai -d openai/gpt-6-luna' },
+    @{ Name = 'openrouter read'; Command = 'curl https://openrouter.ai/api/v1/models' },
+    @{ Name = 'judge trigger without openrouter'; Command = 'node label-judges.mjs'; Deny = $true },
+    @{ Name = 'judge dry run'; Command = 'node label-judges.mjs --dry-run' },
+    @{ Name = 'panel trigger without openrouter'; Command = 'powershell -File run-panel.ps1'; Deny = $true },
+    @{ Name = 'heredoc Bash'; Command = "cat <<'EOF'`nhello`nEOF"; Tool = 'Bash'; Deny = $true },
+    @{ Name = 'heredoc PowerShell'; Command = "Write-Host '<<EOF'" },
+    @{ Name = 'Bash here string'; Command = 'cat <<< hello'; Tool = 'Bash' },
+    @{ Name = 'commit heredoc exemption'; Command = 'git commit -m "$(cat <<EOF)"'; Tool = 'Bash' },
+    @{ Name = 'push before other denials'; Command = 'git push; node run-panel.ps1'; Deny = $true },
+    @{ Name = 'approved push then denied panel'; Command = 'git push; node run-panel.ps1'; Flag = $true; Deny = $true },
+    @{ Name = 'panel before heredoc'; Command = 'run-panel.ps1 <<EOF'; Tool = 'Bash'; Deny = $true },
+    @{ Name = 'dispatcher mention'; Command = 'Write-Host codex-do.ps1' },
+    @{ Name = 'malformed plain'; Raw = '{invalid' },
+    @{ Name = 'malformed trigger'; Raw = '{invalid push openrouter <<' },
+    @{ Name = 'escaped push'; Raw = '{"tool_name":"PowerShell","tool_input":{"command":"git p\u0075sh"}}'; Deny = $true },
+    @{ Name = 'escaped heredoc'; Raw = '{"tool_name":"Bash","tool_input":{"command":"cat \u003c\u003cEOF"}}'; Deny = $true },
+    @{ Name = 'other tool'; Command = 'git push'; Tool = 'Read' },
+    @{ Name = 'missing command'; Raw = '{"tool_name":"Bash","tool_input":{}}' }
+)
+try {
+    $index = 0
+    foreach ($case in $cases) {
+        $index++
+        $tool = 'PowerShell'
+        if ($case.Tool) { $tool = $case.Tool }
+        $payload = if ($case.ContainsKey('Raw')) { $case.Raw } else { New-ShellPayload $case.Command $tool }
+        $results = @()
+        foreach ($variant in @('old', 'new')) {
+            $profile = Join-Path $temp "$index-$variant"
+            $state = Join-Path $profile '.claude\state'
+            [void][IO.Directory]::CreateDirectory($state)
+            $flag = Join-Path $state 'allow-push-once'
+            if ($case.Flag) { [IO.File]::WriteAllText($flag, '') }
+            $scripts = @('shell-guards.ps1')
+            if ($variant -eq 'old') {
+                $scripts = @('git-push-guard.ps1', 'openrouter-model-guard.ps1')
+                if ($tool -eq 'Bash' -or $case.Raw) { $scripts += 'bash-heredoc-guard.ps1' }
+            }
+            foreach ($script in $scripts) {
+                $result = Invoke-TestHook (Join-Path $hooks $script) $payload $profile
+                # Existing malformed JSON can emit stderr; its allow/deny contract is unchanged.
+                if ((Get-HookDecision $result) -ne 'allow|' -or $result.ExitCode -ne 0) { break }
+            }
+            $results += $result
+            if ($case.Flag) { Assert-True (-not (Test-Path -LiteralPath $flag)) "$($case.Name): $variant consumes flag" }
+        }
+        Assert-True ($results[0].ExitCode -eq $results[1].ExitCode -and
+            (Get-HookDecision $results[0]) -ceq (Get-HookDecision $results[1])) "$($case.Name): identical exit, decision, reason"
+        Assert-True (((Get-HookDecision $results[1]) -like 'deny|*') -eq [bool]$case.Deny) "$($case.Name): expected decision"
+        Assert-True ($results[1].ExitCode -eq 0) "$($case.Name): hook exits zero"
+    }
+    # One-use approval, including a failure to claim a locked flag, stays fail-closed.
+    $profile = Join-Path $temp 'one-use'
+    $state = Join-Path $profile '.claude\state'
+    [void][IO.Directory]::CreateDirectory($state)
+    $flag = Join-Path $state 'allow-push-once'
+    [IO.File]::WriteAllText($flag, '')
+    $payload = New-ShellPayload 'git push'
+    Assert-True ((Get-HookDecision (Invoke-TestHook $combined $payload $profile)) -eq 'allow|') 'first push consumes approval'
+    Assert-True ((Get-HookDecision (Invoke-TestHook $combined $payload $profile)) -like 'deny|*') 'second push denied'
+    [IO.File]::WriteAllText($flag, '')
+    $lock = [IO.File]::Open($flag, 'Open', 'ReadWrite', 'None')
+    try {
+        $old = Invoke-TestHook (Join-Path $hooks 'git-push-guard.ps1') $payload $profile
+        $new = Invoke-TestHook $combined $payload $profile
+        Assert-True ((Get-HookDecision $old) -ceq (Get-HookDecision $new) -and (Get-HookDecision $new) -like 'deny|*') 'locked approval fails closed identically'
+    } finally { $lock.Dispose() }
+} finally { Remove-TestFolder $temp }
+Complete-Tests
diff --git a/claude/tests/edit-budget.test.ps1 b/claude/tests/edit-budget.test.ps1
